# Plantilla para Hostinger (hosting compartido).
# Copiar a .env EN EL SERVIDOR y rellenar los valores marcados con <...>.
# Este archivo va al repo SIN secretos. El .env real nunca se commitea.

APP_NAME=CometaX
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# El panel vive en un subdirectorio, no en un subdominio. La ruta forma parte
# de APP_URL: de aquí salen asset() y las URLs de los correos.
APP_URL=https://cometax.click/panel

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

# Flags propias (config/features.php)
APP_MAINTENANCE=false
PAYMENTS_MAINTENANCE=false

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# MySQL de hPanel. El nombre de base y usuario los genera Hostinger con
# prefijo (ej. u413918370_panel) — copiarlos tal cual del panel.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<db_de_hpanel>
DB_USERNAME=<usuario_de_hpanel>
DB_PASSWORD=<password_de_hpanel>

# Hosting compartido: sin daemons. Sesión y caché en base, cola drenada por cron.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Acota la cookie de sesión al panel: la landing comparte dominio y no tiene
# por qué recibirla. Si algún día movés el panel de ruta, esto se actualiza.
SESSION_PATH=/panel
SESSION_DOMAIN=cometax.click
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# SMTP de Hostinger (Correos > Cuentas de correo en hPanel)
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=<no-reply@cometax.click>
MAIL_PASSWORD=<password_del_buzon>
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS=<no-reply@cometax.click>
MAIL_FROM_NAME="${APP_NAME}"

# --- Acceso ---
# Estos correos entran como super_admin (guard 'consultant').
ADMIN_EMAILS=josephfabrizizo@gmail.com
# Vacío = cualquier cuenta de Google puede darse de alta como cliente.
ALLOWED_SIGNUP_DOMAINS=

GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<secret>
# Queda https://cometax.click/panel/auth/google/callback — tiene que coincidir
# carácter por carácter con lo cargado en Google Cloud Console.
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- Stripe ---
STRIPE_KEY=pk_live_<...>
STRIPE_SECRET=sk_live_<...>
STRIPE_WEBHOOK_SECRET=whsec_<...>
CASHIER_CURRENCY=mxn
CASHIER_CURRENCY_LOCALE=es_MX
# El modelo facturable es Client, no User.
CASHIER_MODEL=App\Models\Client
